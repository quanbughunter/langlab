node_modules/
.DS_Store
Thumbs.db
*.log

# Audio đĩa CD của giáo trình — có bản quyền, CHỈ để trên máy, không đưa lên
audio/ko/

# Không đưa sách, file nghe hay bản quét giáo trình lên repo
*.pdf
*.docx
*.rar
*.zip
*.wma
*.mp3
# ...NHƯNG cho phép giọng neural tự tạo (nhẹ, máy tự sinh, không bản quyền) lên mạng:
!audio/tts/
!audio/tts/*.mp3
# mỗi thứ tiếng một thư mục con: audio/tts/ko/, /zh/, /ja/, /ru/, /en-gb/, /en-us/
!audio/tts/*/
!audio/tts/*/*.mp3
*.part

# Ảnh logo bản nháp — chỉ để trên máy, KHÔNG đưa lên repo
logo-b2.png
logo-goc-co-vien.png

# Khoa API va cache ban dich - chi nam tren may minh
api-key.txt
cache/

# Python cache
__pycache__/
*.pyc

# Khoa KRDict - chi tren may minh
tools/krdict-key.txt
tools/.dict-progress.json

# ---- Dong goi Android ----
# www/ la ban sao do tools/gom-app.py sinh ra: mot tep HTML 10 MB cong hang
# nghin mp3. Dung ban goc trong dist/ va audio/ roi sinh lai, dung dua ban sao
# len repo. android/ la du an do «npx cap add android» sinh ra, cung vay.
android-app/www/
android-app/android/
# assets/ do tools/tao-icon.py sinh ra từ logo-icon.png — dựng lại được nên
# không cần đưa lên.
android-app/assets/
android-app/node_modules/
android-app/package-lock.json
*.apk
*.aab
*.keystore
*.jks
# ...NHUNG khoa ky cua ban dung thi PHAI nam trong kho. Khong co no thi may chu
# GitHub moi lan dung lai tu sinh mot khoa khac, bản mới khong cai de duoc ban
# cu — phai go di cai lai, ma go la mat sach tien do hoc. Khoa nay khong phai
# bi mat: mat khau la chu «android», dung quy uoc debug cong khai cua Android,
# ai cung tao duoc mot cai y het. Doi lai, ban ky bang no khong dang Play duoc.
!android-app/keystore/
!android-app/keystore/*.keystore
