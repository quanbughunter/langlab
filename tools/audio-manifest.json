 },
 {
  "text": "옆",
  "kind": "word",
  "lesson": 9,
  "hash": "aaf194bd"
 },
 {
  "text": "수진 씨, 우리 집에 올래요?",
  "kind": "sentence",
  "lesson": 9,
  "hash": "b70a119e"
 },
 {
  "text": "좋아요. 집이 어디예요?",
  "kind": "sentence",
  "lesson": 9,
  "hash": "dbdef2e4"
 },
 {
  "text": "학교 앞에서 왼쪽으로 가세요.",
  "kind": "sentence",
  "lesson": 9,
  "hash": "d71ab8e3"
 },
 {
  "text": "은행 옆에 있는 아파트예요?",
  "kind": "sentence",
  "lesson": 9,
  "hash": "eddb6396"
 },
 {
  "text": "가족",
  "kind": "word",
  "lesson": 9,
  "hash": "b71e3fcd"
 },
 {
  "text": "할아버지께서 신문을 읽으세요.",
  "kind": "sentence",
  "lesson": 10,
  "hash": "bbdd4d04"
 },
 {
  "text": "어머니께서 요리를 하세요.",
  "kind": "sentence",
  "lesson": 10,
  "hash": "3555adba"
 },
 {
  "text": "우리 가족은 네 명이에요.",
  "kind": "sentence",
  "lesson": 10,
  "hash": "565061c4"
 },
 {
  "text": "아버지",
  "kind": "word",
  "lesson": 10,
  "hash": "df55914c"
 },
 {
  "text": "어머니",
  "kind": "word",
  "lesson": 10,
  "hash": "fba08ae4"
 },
 {
