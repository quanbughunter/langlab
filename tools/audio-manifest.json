  "kind": "word",
  "lesson": 11,
  "hash": "fccb826d"
 },
 {
  "text": "오늘 날씨가 어때요?",
  "kind": "sentence",
  "lesson": 11,
  "hash": "8ce4792c"
 },
 {
  "text": "바람이 불고 조금 추워요.",
  "kind": "sentence",
  "lesson": 11,
  "hash": "d0b0a88c"
 },
 {
  "text": "베트남 겨울도 추워요?",
  "kind": "sentence",
  "lesson": 11,
  "hash": "12eb187a"
 },
 {
  "text": "하노이는 춥지만 눈은 안 와요.",
  "kind": "sentence",
  "lesson": 11,
  "hash": "e1342e4d"
 },
 {
  "text": "전화 (1)",
  "kind": "sentence",
  "lesson": 11,
  "hash": "78543c25"
 },
 {
  "text": "친구한테 전화했어요.",
  "kind": "sentence",
  "lesson": 12,
  "hash": "6769bb48"
 },
 {
  "text": "전화했지만 안 받았어요.",
  "kind": "sentence",
  "lesson": 12,
  "hash": "d4e054ab"
 },
 {
  "text": "내일 선생님께 연락하려고 해요.",
  "kind": "sentence",
  "lesson": 12,
  "hash": "f477a33c"
 },
