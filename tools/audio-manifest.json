  "hash": "f5f95f14"
 },
 {
  "text": "오늘이 며칠입니까?",
  "kind": "sentence",
  "lesson": 4,
  "hash": "4105c421"
 },
 {
  "text": "십일 월 이십오 일입니다.",
  "kind": "sentence",
  "lesson": 4,
  "hash": "69564136"
 },
 {
  "text": "그럼 무슨 요일입니까?",
  "kind": "sentence",
  "lesson": 4,
  "hash": "1fcb5045"
 },
 {
  "text": "화요일입니다. 내일은 수요일입니다.",
