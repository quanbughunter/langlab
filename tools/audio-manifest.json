  "lesson": 2,
  "hash": "f11d5225"
 },
 {
  "text": "그것은 무엇입니까?",
  "kind": "sentence",
  "lesson": 2,
  "hash": "b5c4b0f4"
 },
 {
  "text": "도서관도 학교 안에 있습니까?",
  "kind": "sentence",
  "lesson": 2,
  "hash": "13f09b40"
 },
 {
  "text": "일상생활",
  "kind": "word",
  "lesson": 2,
  "hash": "fdb78ca4"
 },
 {
  "text": "저는 매일 한국어를 공부합니다.",
  "kind": "sentence",
  "lesson": 3,
  "hash": "497d52d5"
 },
 {
  "text": "친구가 커피를 마십니다.",
  "kind": "sentence",
  "lesson": 3,
  "hash": "ed7a0ac7"
 },
 {
  "text": "도서관에서 책을 읽습니다.",
  "kind": "sentence",
  "lesson": 3,
  "hash": "5044960e"
 },
