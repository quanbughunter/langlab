  "kind": "word",
  "lesson": 13,
  "hash": "7a4b4edd"
 },
 {
  "text": "카드",
  "kind": "word",
  "lesson": 13,
  "hash": "84e20990"
 },
 {
  "text": "꽃",
  "kind": "word",
  "lesson": 13,
  "hash": "e2aec579"
 },
 {
  "text": "노래하다",
  "kind": "word",
  "lesson": 13,
  "hash": "ec0474f6"
 },
 {
  "text": "나이",
  "kind": "word",
  "lesson": 13,
  "hash": "5afc14dd"
 },
 {
  "text": "돌",
  "kind": "word",
  "lesson": 13,
  "hash": "e7cebd89"
 },
 {
  "text": "히엔 씨, 생일 축하해요!",
  "kind": "sentence",
  "lesson": 13,
  "hash": "daa325e0"
 },
 {
  "text": "고마워요. 와 주셔서 감사합니다.",
  "kind": "sentence",
  "lesson": 13,
  "hash": "cf214c3b"
 },
 {
  "text": "이거 작은 선물이에요.",
  "kind": "sentence",
  "lesson": 13,
  "hash": "d7bc0ef2"
 },
 {
  "text": "민수 씨는 바빠서 못 왔어요.",
  "kind": "sentence",
  "lesson": 13,
  "hash": "e4f1d51a"
 },
 {
  "text": "취미",
  "kind": "word",
  "lesson": 13,
  "hash": "de34ceba"
 },
 {
  "text": "저는 수영할 수 있어요.",
  "kind": "sentence",
  "lesson": 14,
  "hash": "77b212d3"
 },
 {
  "text": "제 취미는 사진 찍기예요.",
  "kind": "sentence",
  "lesson": 14,
  "hash": "bf1d5ed7"
 },
 {
  "text": "저는 음악을 자주 들어요.",
  "kind": "sentence",
  "lesson": 14,
  "hash": "09d3d153"
 },
 {
  "text": "운동",
  "kind": "word",
  "lesson": 14,
  "hash": "d9091ba2"
 },
 {
  "text": "수영",
  "kind": "word",
  "lesson": 14,
  "hash": "2eba33ca"
 },
 {
  "text": "축구",
  "kind": "word",
  "lesson": 14,
  "hash": "00193eed"
 },
 {
  "text": "노래",
  "kind": "word",
  "lesson": 14,
  "hash": "89b385da"
 },
 {
  "text": "그림",
  "kind": "word",
  "lesson": 14,
  "hash": "adef74e1"
 },
 {
  "text": "자주",
  "kind": "word",
  "lesson": 14,
  "hash": "1176af24"
 },
 {
  "text": "가끔",
  "kind": "word",
  "lesson": 14,
  "hash": "20f5cc4f"
 },
 {
  "text": "보통",
  "kind": "word",
  "lesson": 14,
  "hash": "d7576695"
 },
 {
  "text": "잘하다",
  "kind": "word",
  "lesson": 14,
  "hash": "829c1dcd"
 },
 {
  "text": "못하다",
  "kind": "word",
  "lesson": 14,
  "hash": "d68e9891"
 },
 {
  "text": "듣다",
  "kind": "word",
  "lesson": 14,
  "hash": "8d61b036"
 },
 {
  "text": "취미가 뭐예요?",
  "kind": "sentence",
  "lesson": 14,
  "hash": "7287d98f"
 },
 {
  "text": "제 취미는 음악 듣기예요.",
  "kind": "sentence",
  "lesson": 14,
  "hash": "4d7cb37f"
 },
 {
  "text": "악기도 연주할 수 있어요?",
  "kind": "sentence",
  "lesson": 14,
  "hash": "4e54bfb0"
 },
 {
  "text": "기타를 조금 칠 수 있어요.",
  "kind": "sentence",
  "lesson": 14,
  "hash": "693255f1"
 },
 {
  "text": "교통 (1)",
  "kind": "sentence",
  "lesson": 14,
  "hash": "e98b8c50"
 },
 {
  "text": "집에서 학교까지 삼십 분 걸려요.",
  "kind": "sentence",
  "lesson": 15,
  "hash": "d0904667"
 },
 {
  "text": "저는 지하철로 학교에 가요.",
