  "lesson": 13,
  "hash": "d8f962b0"
 },
 {
  "text": "선물",
  "kind": "word",
  "lesson": 13,
  "hash": "58ef4c0c"
 },
 {
  "text": "축하하다",
  "kind": "word",
  "lesson": 13,
  "hash": "f3e485f8"
 },
 {
  "text": "파티",
  "kind": "word",
  "lesson": 13,
  "hash": "6702645c"
 },
 {
  "text": "케이크",
  "kind": "word",
  "lesson": 13,
  "hash": "ad3b8da2"
 },
 {
  "text": "초대하다",
  "kind": "word",
  "lesson": 13,
  "hash": "fd7bf944"
 },
 {
