  "lesson": 15,
  "hash": "253ca5ff"
 },
 {
  "text": "기차",
  "kind": "word",
  "lesson": 15,
  "hash": "840e7573"
 },
 {
  "text": "자전거",
  "kind": "word",
  "lesson": 15,
  "hash": "4096f736"
 },
 {
  "text": "정류장",
  "kind": "word",
  "lesson": 15,
  "hash": "c590c609"
 },
 {
  "text": "역",
  "kind": "word",
  "lesson": 15,
  "hash": "2009a63b"
 },
 {
  "text": "타다",
  "kind": "word",
  "lesson": 15,
  "hash": "fe4c84e7"
 },
 {
  "text": "내리다",
  "kind": "word",
  "lesson": 15,
  "hash": "fa20488b"
 },
 {
  "text": "갈아타다",
  "kind": "word",
  "lesson": 15,
  "hash": "98f953c8"
 },
 {
  "text": "얼마나",
  "kind": "word",
  "lesson": 15,
  "hash": "73215f7c"
 },
 {
  "text": "걸리다",
  "kind": "word",
  "lesson": 15,
  "hash": "b1a664bb"
 },
 {
  "text": "명동에 어떻게 가요?",
  "kind": "sentence",
  "lesson": 15,
  "hash": "ef82e72a"
 },
 {
  "text": "지하철 사호선을 타세요.",
