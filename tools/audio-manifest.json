  "hash": "faa9095e"
 },
 {
  "text": "어디",
  "kind": "word",
  "lesson": 6,
  "hash": "78cef306"
 },
 {
  "text": "무엇",
  "kind": "word",
  "lesson": 6,
  "hash": "886e3ef0"
 },
 {
  "text": "누구",
  "kind": "word",
  "lesson": 6,
  "hash": "b879e5fd"
 },
 {
  "text": "왜",
  "kind": "word",
  "lesson": 6,
  "hash": "72f090fe"
 },
 {
  "text": "지난 주말에 뭐 했어요?",
  "kind": "sentence",
  "lesson": 6,
  "hash": "94e5c075"
 },
 {
  "text": "친구하고 영화를 봤어요.",
  "kind": "sentence",
  "lesson": 6,
  "hash": "89c59e88"
 },
 {
  "text": "재미있었어요?",
  "kind": "sentence",
  "lesson": 6,
  "hash": "c0d0abad"
 },
 {
  "text": "네, 아주 좋았어요. 이번 주말에 같이 봅시다.",
  "kind": "sentence",
  "lesson": 6,
  "hash": "683a373d"
 },
 {
  "text": "물건 사기 (1)",
  "kind": "sentence",
  "lesson": 6,
  "hash": "9d836981"
 },
 {
  "text": "저는 김치를 사고 싶어요.",
  "kind": "sentence",
  "lesson": 7,
  "hash": "899658ee"
 },
 {
  "text": "이것은 싸요. 그런데 저것은 비싸요.",
  "kind": "sentence",
  "lesson": 7,
  "hash": "762520b5"
 },
 {
  "text": "가격이 너무 비싸요.",
  "kind": "sentence",
  "lesson": 7,
  "hash": "96681760"
 },
 {
  "text": "얼마",
  "kind": "word",
  "lesson": 7,
  "hash": "594d6e89"
 },
 {
  "text": "원",
  "kind": "word",
  "lesson": 7,
  "hash": "22eb95e0"
