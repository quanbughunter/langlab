  "kind": "word",
  "lesson": 7,
  "hash": "1aaf65be"
 },
 {
  "text": "권",
  "kind": "word",
  "lesson": 7,
  "hash": "8dcba927"
 },
 {
  "text": "가격",
  "kind": "word",
  "lesson": 7,
  "hash": "2b31c12c"
 },
 {
  "text": "싸다",
  "kind": "word",
  "lesson": 7,
  "hash": "8033e616"
 },
 {
  "text": "비싸다",
  "kind": "word",
  "lesson": 7,
  "hash": "2b5fc21c"
 },
 {
  "text": "주세요",
  "kind": "word",
  "lesson": 7,
  "hash": "2c82823e"
 },
 {
  "text": "시장",
  "kind": "word",
  "lesson": 7,
  "hash": "0fe03525"
 },
 {
  "text": "가게",
  "kind": "word",
  "lesson": 7,
  "hash": "08318a13"
 },
 {
  "text": "돈",
  "kind": "word",
  "lesson": 7,
  "hash": "ebcec3d5"
 },
 {
  "text": "이 사과는 얼마예요?",
  "kind": "sentence",
  "lesson": 7,
  "hash": "ffa5c65b"
 },
 {
  "text": "한 개에 이천 원이에요.",
  "kind": "sentence",
  "lesson": 7,
  "hash": "d4ab39bc"
 },
 {
  "text": "조금 비싸요. 세 개 주세요.",
  "kind": "sentence",
  "lesson": 7,
  "hash": "b56fd1aa"
 },
 {
  "text": "네, 육천 원입니다.",
  "kind": "sentence",
  "lesson": 7,
  "hash": "671b2813"
 },
 {
  "text": "음식",
  "kind": "word",
  "lesson": 7,
  "hash": "71a47512"
 },
 {
  "text": "여기 앉으세요.",
  "kind": "sentence",
  "lesson": 8,
  "hash": "a22ef864"
 },
 {
  "text": "이 음식은 맵지 않아요.",
  "kind": "sentence",
  "lesson": 8,
  "hash": "fa6636ae"
 },
 {
  "text": "저는 비빔밥을 먹겠습니다.",
  "kind": "sentence",
  "lesson": 8,
  "hash": "7acf220c"
 },
