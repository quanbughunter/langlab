  "text": "문자",
  "kind": "word",
  "lesson": 12,
  "hash": "439e3a18"
 },
 {
  "text": "여보세요",
  "kind": "word",
  "lesson": 12,
  "hash": "1d6429c4"
 },
 {
  "text": "잠깐만요",
  "kind": "word",
  "lesson": 12,
  "hash": "9b7354c0"
 },
 {
  "text": "끊다",
  "kind": "word",
  "lesson": 12,
  "hash": "f5675151"
 },
 {
  "text": "연락하다",
  "kind": "word",
  "lesson": 12,
  "hash": "de219717"
 },
 {
  "text": "부탁하다",
  "kind": "word",
  "lesson": 12,
  "hash": "930be4c3"
 },
 {
  "text": "여보세요, 거기 민수 씨 집이지요?",
  "kind": "sentence",
  "lesson": 12,
  "hash": "9ee2fed4"
 },
 {
  "text": "네, 제가 민수인데요.",
  "kind": "sentence",
  "lesson": 12,
  "hash": "ee830b85"
 },
 {
  "text": "내일 같이 공부하려고 전화했어요.",
  "kind": "sentence",
  "lesson": 12,
  "hash": "abba1131"
 },
 {
  "text": "좋아요. 그럼 두 시에 만나요.",
  "kind": "sentence",
  "lesson": 12,
  "hash": "653d7b1d"
 },
 {
  "text": "생일이어서 친구들을 초대했어요.",
  "kind": "sentence",
  "lesson": 13,
  "hash": "01be6cda"
 },
 {
  "text": "무슨 선물을 살까요?",
  "kind": "sentence",
  "lesson": 13,
  "hash": "2d518188"
 },
 {
  "text": "바빠서 파티에 못 갔어요.",
