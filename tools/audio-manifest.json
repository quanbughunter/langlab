  "lesson": 10,
  "hash": "1d5d60f2"
 },
 {
  "text": "할아버지",
  "kind": "word",
  "lesson": 10,
  "hash": "68c59bfc"
 },
 {
  "text": "할머니",
  "kind": "word",
  "lesson": 10,
  "hash": "64779620"
 },
 {
  "text": "계시다",
  "kind": "word",
  "lesson": 10,
  "hash": "484f9f75"
 },
 {
  "text": "연세",
  "kind": "word",
  "lesson": 10,
  "hash": "d01602dc"
 },
 {
  "text": "가족이 몇 명이에요?",
  "kind": "sentence",
  "lesson": 10,
  "hash": "7cda91cf"
 },
 {
  "text": "네 명이에요. 부모님하고 여동생이 있어요.",
  "kind": "sentence",
  "lesson": 10,
  "hash": "da180352"
 },
 {
  "text": "부모님께서는 무슨 일을 하세요?",
  "kind": "sentence",
  "lesson": 10,
  "hash": "29d520cb"
 },
 {
  "text": "아버지께서는 선생님이세요.",
  "kind": "sentence",
  "lesson": 10,
  "hash": "a67fe20b"
 },
 {
  "text": "날씨",
  "kind": "word",
  "lesson": 10,
  "hash": "3bf19400"
 },
 {
  "text": "내일은 비가 올 거예요.",
  "kind": "sentence",
  "lesson": 11,
  "hash": "70af2965"
 },
 {
  "text": "유월부터 팔월까지 아주 더워요.",
  "kind": "sentence",
  "lesson": 11,
  "hash": "5d965ceb"
 },
 {
  "text": "한국의 겨울은 정말 추워요.",
  "kind": "sentence",
  "lesson": 11,
  "hash": "d2c35993"
 },
 {
