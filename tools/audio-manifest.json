  "lesson": 1,
  "hash": "850f6dff"
 },
 {
  "text": "안녕하세요? 저는 김민수입니다.",
  "kind": "sentence",
  "lesson": 1,
  "hash": "98a297ff"
 },
 {
  "text": "안녕하세요? 저는 히엔입니다.",
  "kind": "sentence",
  "lesson": 1,
  "hash": "3efa8a6c"
 },
 {
  "text": "히엔 씨는 어느 나라 사람입니까?",
  "kind": "sentence",
  "lesson": 1,
  "hash": "d3c8581a"
 },
 {
  "text": "저는 베트남 사람입니다. 반갑습니다.",
  "kind": "sentence",
  "lesson": 1,
  "hash": "0cfea4a6"
 },
 {
  "text": "학교",
  "kind": "word",
  "lesson": 1,
  "hash": "fbbf094d"
 },
 {
  "text": "이것은 한국어 책입니다.",
  "kind": "sentence",
  "lesson": 2,
  "hash": "6e50c56b"
 },
 {
  "text": "교실에 칠판이 있습니다.",
