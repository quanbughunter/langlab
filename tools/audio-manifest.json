  "kind": "word",
  "lesson": 8,
  "hash": "f56c2707"
 },
 {
  "text": "어서 오세요. 뭘 드시겠어요?",
  "kind": "sentence",
  "lesson": 8,
  "hash": "9d38216f"
 },
 {
  "text": "비빔밥 하나 주세요.",
  "kind": "sentence",
  "lesson": 8,
  "hash": "b40b9297"
 },
 {
  "text": "맵게 해 드릴까요?",
  "kind": "sentence",
  "lesson": 8,
  "hash": "0b57d2f7"
 },
 {
  "text": "아니요, 맵지 않게 해 주세요.",
  "kind": "sentence",
  "lesson": 8,
  "hash": "55b21336"
 },
 {
  "text": "집",
  "kind": "word",
  "lesson": 8,
  "hash": "6c312d4f"
 },
 {
  "text": "오른쪽으로 가세요.",
  "kind": "sentence",
  "lesson": 9,
  "hash": "e25a2bf0"
 },
 {
  "text": "우리 집에 올래요?",
  "kind": "sentence",
  "lesson": 9,
  "hash": "613816f9"
 },
 {
  "text": "제 방에는 책상도 있어요.",
  "kind": "sentence",
  "lesson": 9,
  "hash": "31437409"
 },
